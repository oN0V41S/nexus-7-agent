{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "gemini": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  },
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "description": "Orquestrador Nexus - gerencia o pipeline harness de 6 estágios",
      "mode": "primary",
      "model": "gemini-2.5-pro",
      "temperature": 0.1,
      "maxSteps": 50,
      "tools": {
        "task": true,
        "question": true,
        "skill": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "security-secret-auditor": {
      "description": "Auditoria de segurança no código",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask"
      }
    },
    "quality-assurance-analyst": {
      "description": "Testes e validação de qualidade",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "docs-architect": {
      "description": "Documentação técnica",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.2,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "ask"
      }
    },
    "testsprite-mcp-agent": {
      "description": "Integração e orquestração do TestSprite MCP Server para testes automatizados de UI e API",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true,
        "task": true,
        "nexus-log": true,
        "nexus-memory": true,
        "nexus-handoff": true
      },
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "cbm-agent": {
      "description": "Code intelligence via codebase-memory-mcp knowledge graph (14 tools)",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "bash": "allow",
        "read": "allow",
        "write": "deny"
      }
    },
    "notion-agent": {
      "description": "Especialista em gerenciar conteúdo no Notion via MCP",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "ask"
      }
    },
    "job-apply-agent": {
      "description": "Agente principal do Job Application Workflow - busca, análise, consolidação, geração e aplicação de vagas",
      "mode": "primary",
      "model": "gemini-2.5-pro",
      "temperature": 0.1,
      "maxSteps": 100,
      "tools": {
        "task": true,
        "question": true,
        "skill": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "playwright-agent": {
      "description": "Automação de navegador via Playwright MCP — navegar, clicar, preencher formulários, extrair dados, testar UI",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "chrome-devtools-agent": {
      "description": "Debugging frontend via Chrome DevTools MCP — performance, network, console, memory, accessibility",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "oracle": {
      "description": "Strategic advisor for architecture, code review, and complex debugging",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "ask"
      }
    },
    "explorer": {
      "description": "Fast codebase search and pattern matching",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "deny"
      }
    },
    "fixer": {
      "description": "Fast implementation specialist for well-defined tasks",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "librarian": {
      "description": "External documentation and library research specialist",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "webfetch": true,
        "websearch": true
      },
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "ask",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "designer": {
      "description": "UI/UX design, review and implementation",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "spec-reviewer": {
      "description": "Spec review for completeness, consistency and testability",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "deny"
      }
    },
    "google-workspace-agent": {
      "description": "Google Workspace specialist — Drive, Docs, Sheets, Gmail",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "ask"
      }
    },
    "councillor": {
      "description": "Read-only council advisor for independent analysis",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "deny"
      }
    },
    "observer": {
      "description": "Read-only observer for monitoring and analysis",
      "mode": "subagent",
      "model": "deepseek-v4-flash-free",
      "temperature": 0.1,
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    ".opencode/plugins/nexus-plugin.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "command": {
    "super-pipeline": {
      "description": "Pipeline harness aprimorado: delega cada estágio (SPEC→PLAN→ANALYZE→BUILD→REVIEW→DOCUMENT) a sub-agents especializados com paralelização",
      "template": "{file:.opencode/commands/super-pipeline.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    },
    "plan": {
      "description": "Planeja feature usando pipeline harness",
      "template": "{file:.opencode/commands/plan.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    },
    "security": {
      "description": "Auditoria de segurança no código",
      "template": "{file:.opencode/commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-secret-auditor",
      "subtask": true
    },
    "qa": {
      "description": "Testes e validação de qualidade",
      "template": "{file:.opencode/commands/qa.md}\n\n$ARGUMENTS",
      "agent": "quality-assurance-analyst",
      "subtask": true
    },
    "docs": {
      "description": "Documentação técnica",
      "template": "{file:.opencode/commands/docs.md}\n\n$ARGUMENTS",
      "agent": "docs-architect",
      "subtask": true
    },
    "memory": {
      "description": "Consulta memória persistente do harness",
      "template": "{file:.opencode/commands/memory.md}\n\n$ARGUMENTS"
    },
    "criar-agente": {
      "description": "Cria novo agente para o ecossistema Nexus",
      "template": "{file:.opencode/commands/criar-agente.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    },
    "cbm-query": {
      "description": "Consulta o knowledge graph do codebase-memory-mcp (Cypher query ou nome de função)",
      "template": "{file:.opencode/commands/cbm-query.md}\n\n$ARGUMENTS",
      "agent": "cbm-agent",
      "subtask": true
    },
    "job-search": {
      "description": "Busca vagas em múltiplas plataformas (LinkedIn, Glassdoor, Indeed, Monster)",
      "template": "{file:.opencode/skills/job-apply-agent/commands/search.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-analyze": {
      "description": "Calcula match score e gaps de competência para vagas encontradas",
      "template": "{file:.opencode/skills/job-apply-agent/commands/analyze.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-consolidate": {
      "description": "Consolida múltiplos PDFs de currículo em DOCX ATS de 1 página",
      "template": "{file:.opencode/skills/job-apply-agent/commands/consolidate.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-adapt": {
      "description": "Gera currículo adaptado e carta de apresentação contextualizada",
      "template": "{file:.opencode/skills/job-apply-agent/commands/adapt.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-apply": {
      "description": "Executa aplicação com aprovação humana via Chrome/Playwright MCP",
      "template": "{file:.opencode/skills/job-apply-agent/commands/apply.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-track": {
      "description": "Atualiza status de candidaturas no Notion e exporta relatórios",
      "template": "{file:.opencode/skills/job-apply-agent/commands/track.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "job-kb": {
      "description": "Gera Knowledge Base .md completa do currículo do candidato a partir de PDFs",
      "template": "{file:.opencode/skills/job-apply-agent/commands/kb.md}\n\n$ARGUMENTS",
      "agent": "job-apply-agent",
      "subtask": true
    },
    "playwright": {
      "description": "Automação de navegador via Playwright MCP",
      "template": "Use o agente @playwright-agent para automação de navegador via Playwright MCP.\n\n$ARGUMENTS\n\nTarefas comuns: navegar para URL, clicar em elementos, preencher formulários, extrair dados de páginas, tirar screenshots, testar fluxos de UI.",
      "agent": "playwright-agent",
      "subtask": true
    },
    "devtools": {
      "description": "Debugging frontend via Chrome DevTools MCP",
      "template": "Use o agente @chrome-devtools-agent para debugging frontend via Chrome DevTools MCP.\n\n$ARGUMENTS\n\nTarefas comuns: analisar performance, inspecionar network requests, ler console logs, verificar accessibility, capturar screenshots, debugar memory leaks.",
      "agent": "chrome-devtools-agent",
      "subtask": true
    },
    "opensre": {
      "description": "Investigação de incidentes com OpenSRE (RCA automatizada)",
      "template": "{file:.opencode/commands/opensre.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    }
  },
  "permission": {
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "task": "allow",
    "nexus-log": "allow",
    "nexus-memory": "allow",
    "nexus-handoff": "allow"
  },
  "mcp": {
    "notion": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "/home/codespace/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "enabled": true
    },
    "google-workspace": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/google-workspace/server.mjs"
      ],
      "enabled": true
    },
    "nexus-memory-server": {
      "type": "local",
      "command": [
        "npx",
        "tsx",
        ".opencode/mcp/nexus-memory-server.ts"
      ],
      "enabled": true
    },
    "job-apply-mcp": {
      "type": "local",
      "command": [
        "npx",
        "tsx",
        ".opencode/mcp/job-apply-mcp.ts"
      ],
      "enabled": true
    }
  }
}
