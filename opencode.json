{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,

  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "gemini": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  },

  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "description": "Orquestrador Nexus - gerencia o pipeline harness de 5 estágios",
      "mode": "primary",
      "temperature": 0.1,
      "maxSteps": 50,
      "tools": {
        "task": true,
        "question": true,
        "skill": true,
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true
      },
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "security-secret-auditor": {
      "description": "Auditoria de segurança no código",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask"
      }
    },
    "quality-assurance-analyst": {
      "description": "Testes e validação de qualidade",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "docs-architect": {
      "description": "Documentação técnica",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.2,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "ask"
      }
    },
    "testsprite-mcp-agent": {
      "description": "Integração e orquestração do TestSprite MCP Server para testes automatizados de UI e API",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "webfetch": true,
        "websearch": true,
        "task": true,
        "nexus-log": true,
        "nexus-memory": true,
        "nexus-handoff": true
      },
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    }
  },

  "instructions": [
    "AGENTS.md"
  ],

  "plugin": [
    ".opencode/plugins/nexus-plugin.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],

  "command": {
    "plan": {
      "description": "Planeja feature usando pipeline harness",
      "template": "{file:.opencode/commands/plan.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    },
    "security": {
      "description": "Auditoria de segurança no código",
      "template": "{file:.opencode/commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-secret-auditor",
      "subtask": true
    },
    "qa": {
      "description": "Testes e validação de qualidade",
      "template": "{file:.opencode/commands/qa.md}\n\n$ARGUMENTS",
      "agent": "quality-assurance-analyst",
      "subtask": true
    },
    "docs": {
      "description": "Documentação técnica",
      "template": "{file:.opencode/commands/docs.md}\n\n$ARGUMENTS",
      "agent": "docs-architect",
      "subtask": true
    },
    "memory": {
      "description": "Consulta memória persistente do harness",
      "template": "{file:.opencode/commands/memory.md}\n\n$ARGUMENTS"
    },
    "criar-agente": {
      "description": "Cria novo agente para o ecossistema Nexus",
      "template": "{file:.opencode/commands/criar-agente.md}\n\n$ARGUMENTS",
      "agent": "orchestrator",
      "subtask": true
    }
  },

  "permission": {
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "task": "allow",
    "nexus-log": "allow",
    "nexus-memory": "allow",
    "nexus-handoff": "allow"
  },

  "mcp": {
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
