# Notion MCP - Conexão Primária (OAuth via mcp-remote)
# Conecta via OAuth: https://mcp.notion.com/mcp
# O token é obtido via fluxo OAuth no navegador (sem token hardcoded)

# Notion MCP - Conexão Fallback (Token de Integração)
# Usado como fallback para workspaces alternativos / outro email
NOTION_TOKEN=ntn_your_notion_integration_token
# NOTION_TOKEN_FALLBACK=ntn_your_secondary_integration_token

# OpenCode Zen API Key
# Obtenha em: https://opencode.ai
OPENCODE_API_KEY=sk-your_opencode_api_key

# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key

# ============================================
# MongoDB (Optional - for remote sync)
# ============================================
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nexus-memory
# MONGODB_DB_NAME=nexus-memory
# MONGODB_TIMEOUT_MS=5000
